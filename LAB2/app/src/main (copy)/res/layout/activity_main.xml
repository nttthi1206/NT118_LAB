<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Thông tin Sinh viên -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#1976D2"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/student_info"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/app_title_dashboard"
        android:textColor="#1976D2"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_th1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_th1" />

    <Button
        android:id="@+id/btn_th3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_th3" />

    <Button
        android:id="@+id/btn_th4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_th4" />

    <Button
        android:id="@+id/btn_th5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_th5" />

    <Button
        android:id="@+id/btn_th6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_th6" />

    <Button
        android:id="@+id/btn_qlma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:text="@string/title_qlma" />

</LinearLayout>